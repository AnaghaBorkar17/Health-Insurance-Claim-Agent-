# ==============================================================================
# Multi-Agent Health Insurance Claim System Configuration
# ==============================================================================

# Google Gemini API Configuration (Cloud LLM)
# Obtain a key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Ollama Configuration (Local LLM & Embeddings)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIR=./data/chroma

# Relational Database & Checkpointing (SQLite)
DATABASE_PATH=./data/claims.db

# Logging & Environment
LOG_LEVEL=INFO
APP_ENV=development
